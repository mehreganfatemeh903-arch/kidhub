<style id="wp-custom-css">
/* فقط برای فرم با id = wpcf7-f29721-p3323-o1 */
div[id="wpcf7-f29721-p3323-o1"] form {
  text-align: center;
}

div[id="wpcf7-f29721-p3323-o1"] label {
  color: #fff;
  font-weight: bold;
  display: block;
  margin-bottom: 10px;
}

div[id="wpcf7-f29721-p3323-o1"] input[type="email"] {
  width: 80%;
  padding: 10px;
  border: 2px solid #ccc;
  border-radius: 12px;
  font-size: 16px;
  margin: 10px auto;
  display: block;
  text-align: center;
  background-color: transparent;
  color: #fff;
}

div[id="wpcf7-f29721-p3323-o1"] input[type="submit"] {
  background-color: #003366;
  color: #fff;
  font-weight: bold;
  padding: 10px 25px;
  border: none;
  border-radius: 12px;
  cursor: pointer;
  margin-top: 10px;
  transition: 0.3s;
}

div[id="wpcf7-f29721-p3323-o1"] input[type="submit"]:hover {
  background-color: #004c99;
}
/*start mahbobtarinha*/
.wd-nav-wrapper.wd-nav-tabs-wrapper.tabs-navigation-wrapper {
    padding-bottom: 24px !important;
}
ul.wd-nav.wd-nav-tabs.products-tabs-title.wd-style-default.wd-icon-pos-top li {
    position: relative;
    border: 1px solid #cfe4f7;
    border-radius: 12px;
    padding: 7px;
    background: #f0f8ff;
}
a.wd-nav-link {
    color: #087339 !important;
    font-weight: bolder !important;
    font-size: 16px !important;
}
/*end mahbobtarinha*/
</style>
